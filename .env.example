# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:15432/microcoaching
REDIS_URL=redis://localhost:16379/0

# ── AI Cloud Provider (google | openai) ──────────────────
AI_CLOUD_PROVIDER=google

# ── Google: Vertex AI (preferred for service-account auth) ───
# Set GOOGLE_USE_VERTEX=true and provide the four GOOGLE_CLOUD_*
# values below. GOOGLE_API_KEY is ignored when Vertex is enabled.
GOOGLE_USE_VERTEX=true
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
# Path to the service-account JSON inside the ai-runtime container.
# Leave this at the default; set GCP_SERVICE_ACCOUNT_JSON_HOST_PATH
# below to the host path so docker-compose bind-mounts it here.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json
# Host-side path to the same JSON file — overridden by docker-compose.
# Required when GOOGLE_USE_VERTEX=true; left unset compose still starts
# cleanly but the first LLM call will fail with a clear auth error.
GCP_SERVICE_ACCOUNT_JSON_HOST_PATH=/path/to/your/gcp-service-account.json

# ── Google: Developer API (api-key auth, fallback) ───────────
# Used only when GOOGLE_USE_VERTEX is false.
GOOGLE_API_KEY=

# ── Google: model selection ──────────────────────────────────
# All four must be a model your Vertex project actually has access
# to in GOOGLE_CLOUD_LOCATION; a 404 here will surface as a Stage B
# (or A / C) failure in the orchestrator.
GOOGLE_INFERENCE_MODEL=gemini-2.5-flash
GOOGLE_IDENTIFICATION_MODEL=gemini-2.5-pro
GOOGLE_VISION_MODEL=gemini-2.5-flash
GOOGLE_EMBEDDING_MODEL=text-embedding-005

# OpenAI (when AI_CLOUD_PROVIDER=openai)
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_INFERENCE_MODEL=gpt-4o-mini

# ── Local Ollama (inference only) ────────────────────────
USE_OLLAMA=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b

# ── Embedding ────────────────────────────────────────────
EMBEDDING_DIMENSION=768
TOP_K=5

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
APP_ENV=development
AI_RUNTIME_TOKEN=replace-with-strong-internal-token
# Local docker-compose DB user is postgres; keep this aligned with DATABASE_PASSWORD.
DATABASE_PASSWORD=replace-with-strong-db-password
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ── SPICE auth-service (platform token validation) ─────────
# When true, every platform-api route (except health/ready) requires a valid
# SPICE JWT validated via POST {SPICE_AUTH_BASE_URL}/authenticate.
# Set false only for isolated local runs without auth-service.
SPICE_AUTH_ENABLED=true
# Auth-service root: direct (http://authservice:8089) or nginx proxy
# (http://gateway/auth-service). No trailing slash.
SPICE_AUTH_BASE_URL=http://localhost:8089
SPICE_AUTH_TIMEOUT_SECONDS=5.0
SPICE_AUTH_DEFAULT_CLIENT=mob
SPICE_AUTH_EXEMPT_PATHS=health,ready
SPICE_ADMIN_PATH_PREFIXES=admin,dashboard
SPICE_DEVICE_PATH_PREFIXES=telemetry,sync,morning,coaching
SPICE_TENANT_ID_MAP=

# ── Platform service ─────────────────────────────────────
UPLOAD_DIR=/tmp/microcoaching/uploads

# ── Stage 2-draft — optional published-module merge ────────
# When enabled, Stage D may merge newly drafted cards into a similar
# active (non-retired) published module.
STAGE_D_PUBLISHED_MERGE_ENABLED=true
STAGE_D_PUBLISHED_MERGE_PREFILTER_LIMIT=25
STAGE_D_PUBLISHED_MERGE_MAX_OUTPUT_TOKENS=4000
# Deterministic content gate: fraction of existing cards that must match
# the new card set (by text similarity or shared source_block_id).
STAGE_D_PUBLISHED_MERGE_MIN_EXISTING_CARD_MATCH_RATIO=0.0
# Per existing card, best new-card trigram similarity must exceed this.
STAGE_D_PUBLISHED_MERGE_CARD_SIMILARITY_THRESHOLD=0.0
# Whole-module fingerprint similarity floor (both card sets concatenated).
STAGE_D_PUBLISHED_MERGE_MODULE_SIMILARITY_THRESHOLD=0.0

# ── MinIO object storage ─────────────────────────────────
# Compose maps host port 19002 to MinIO S3 API (container 9000); 19000 is
# ClickHouse native. Console UI is on host port 19001 (container 9001).
MINIO_ENDPOINT=localhost:19002
MINIO_PRESIGNED_ENDPOINT=localhost:19002
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_BUCKET_NAME=medtronics-storage
# When false, the API refuses to auto-create the bucket (prefer false in production with IaC-managed buckets).
MINIO_AUTO_CREATE_BUCKET=true
# Local Docker uses plain HTTP; set true for any non-local MinIO endpoint.
MINIO_SECURE=false
MINIO_REGION=us-east-1
ADMIN_FILE_ALLOWED_PREFIXES=uploads,source-documents,media,ingest
ADMIN_FILE_PRESIGNED_MAX_SECONDS=86400

# ── ClickHouse (platform only) ───────────────────────────
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=18123
# CLICKHOUSE_DATABASE=microcoaching
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

# ── Analytics dashboard (docker compose --profile dashboard) ─────────────
# Optional UI from micro-learning-analytics-dashboard. Build the image locally
# (see docker-compose.yml) or set ANALYTICS_DASHBOARD_BUILD_CONTEXT to that repo.
# ANALYTICS_DASHBOARD_IMAGE=micro-learning-analytics-dashboard:local
# ANALYTICS_DASHBOARD_PORT=18080
# VITE_ADMIN_API_BASE_URL=http://localhost:18000
# VITE_USE_MOCK_API=false

# ── Safety ───────────────────────────────────────────────
RETRIEVAL_REQUIRE_VALIDATED=false
SPICE_REFERRAL_DESTINATIONS=Upazila Health Complex (UHC),Community Clinic,District Hospital,Union Health Centre,Mother and Child Welfare Centre (MCWC),Emergency Obstetric Care (EmOC),Nutrition Rehabilitation Unit (NRU),Upazila Health and Family Planning Officer (UHFPO),BRAC Health Programme Clinic
