# Host-oriented defaults for local development (uvicorn/pytest outside Compose).
# docker-compose.yml overrides container DNS (db, redis, minio:9000, ai-runtime).
# Copy to .env and fill Google/Vertex secrets before `docker compose up`.

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:15432/microcoaching
DATABASE_PASSWORD=postgres
REDIS_URL=redis://localhost:16379/0

# ── AI Runtime (platform → ai-runtime) ────────────────────
AI_RUNTIME_BASE_URL=http://localhost:18001
AI_RUNTIME_TOKEN=dev-internal-token
AI_RUNTIME_TIMEOUT_SECONDS=600
AI_RUNTIME_TRANSCRIBE_TIMEOUT_SECONDS=600

# ── AI Cloud Provider (ai-runtime only) ───────────────────
AI_CLOUD_PROVIDER=google

# ── Google: Vertex AI (preferred for service-account auth) ───
# Set GOOGLE_USE_VERTEX=true and provide the four GOOGLE_CLOUD_*
# values below. GOOGLE_API_KEY is ignored when Vertex is enabled.
GOOGLE_USE_VERTEX=true
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
# Path to the service-account JSON inside the ai-runtime container.
# Leave this at the default; set GCP_SERVICE_ACCOUNT_JSON_HOST_PATH
# below to the host path so docker-compose bind-mounts it here.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json
# Host-side path to the same JSON file — overridden by docker-compose.
# Required when GOOGLE_USE_VERTEX=true; left unset compose still starts
# cleanly but the first LLM call will fail with a clear auth error.
GCP_SERVICE_ACCOUNT_JSON_HOST_PATH=/path/to/your/gcp-service-account.json
# Optional: base64-encoded service-account JSON (skips the bind-mount).
GOOGLE_SERVICE_ACCOUNT_BASE64=

# ── Google: Developer API (api-key auth, fallback) ───────────
# Used only when GOOGLE_USE_VERTEX is false.
GOOGLE_API_KEY=
# Optional alias accepted by compose: ${GOOGLE_API_KEY:-${GEMINI_API_KEY:-}}
GEMINI_API_KEY=

# ── Google: embedding model (ai-runtime only) ────────────────
# Generate models and per-GenerationType budgets live in
# ai_runtime.generation_profiles (code defaults). Deploy ai-runtime
# before platform when cutting over.
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

# ── Embedding (platform assert + ai-runtime align) ───────────
EMBEDDING_DIMENSION=768
TOP_K=5
# Durable vector backend behind mc_foundation.VectorStore.
# Only ``pgvector`` is implemented today (vectors on module.embedding).
VECTOR_STORE_BACKEND=pgvector

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
APP_ENV=development

# ── SPICE auth-service (platform token validation) ─────────
# When true, every platform-api route (except ready) requires a valid
# SPICE JWT validated via POST {SPICE_AUTH_BASE_URL}/authenticate.
# Compose wires the four keys below (default off for local).
SPICE_AUTH_ENABLED=false
# Auth-service root: direct (http://authservice:8089) or nginx proxy
# (http://gateway/auth-service). No trailing slash.
# Host: localhost; Compose default for containers: host.docker.internal.
SPICE_AUTH_BASE_URL=http://localhost:8089
SPICE_AUTH_TIMEOUT_SECONDS=5.0
SPICE_AUTH_DEFAULT_CLIENT=mob
SPICE_AUTH_EXEMPT_PATHS=ready
SPICE_ADMIN_PATH_PREFIXES=admin,dashboard
SPICE_DEVICE_PATH_PREFIXES=telemetry,sync,morning,coaching

# ── Platform service ─────────────────────────────────────
UPLOAD_DIR=/tmp/microcoaching/uploads

# ── Stage 2-draft — published-module merge tuning ───────────
# Stage D always attempts merge into a similar active (non-retired)
# published module (fusion drafts opt out internally).
STAGE_D_PUBLISHED_MERGE_PREFILTER_LIMIT=25
# Deterministic content gate: fraction of existing cards that must match
# the new card set (by text similarity or shared source_block_id).
STAGE_D_PUBLISHED_MERGE_MIN_EXISTING_CARD_MATCH_RATIO=0.0
# Per existing card, best new-card trigram similarity must exceed this.
STAGE_D_PUBLISHED_MERGE_CARD_SIMILARITY_THRESHOLD=0.0
# Whole-module fingerprint similarity floor (both card sets concatenated).
STAGE_D_PUBLISHED_MERGE_MODULE_SIMILARITY_THRESHOLD=0.0

# ── Post-publish — search metadata ─────────────────────────
POST_PUBLISH_SEARCH_METADATA_ENABLED=true
SEARCH_METADATA_MAX_KEYWORDS=15
SEARCH_METADATA_MAX_SEARCH_PHRASES=10
SEARCH_METADATA_MAX_SYNONYMS=10
SEARCH_METADATA_MAX_TAGS=10

# ── Chat FAQ mining (Celery beat / worker) ─────────────────
CHAT_FAQ_LOOKBACK_DAYS=90
CHAT_FAQ_MIN_OCCURRENCE_COUNT=3
CHAT_FAQ_MIN_QUESTION_LENGTH=5
CHAT_FAQ_TARGET_COUNT=6
CHAT_FAQ_MIN_OUTPUT_COUNT=5
CHAT_FAQ_CLUSTER_CANDIDATE_LIMIT=100
CHAT_FAQ_WEEKLY_HOUR_UTC=2
CHAT_FAQ_WEEKLY_DAY_OF_WEEK=0

# ── Chat feedback summary (Celery beat / worker) ───────────
CHAT_FEEDBACK_SUMMARY_WEEKLY_HOUR_UTC=3
CHAT_FEEDBACK_SUMMARY_WEEKLY_DAY_OF_WEEK=0
CHAT_FEEDBACK_SUMMARY_LLM_TIMEOUT_SECONDS=90
CHAT_FEEDBACK_SUMMARY_FIRST_RUN_LOOKBACK_DAYS=90
CHAT_FEEDBACK_SUMMARY_MAX_POSITIVE_ONLINE_SAMPLES=10
CHAT_FEEDBACK_SUMMARY_MAX_POSITIVE_OFFLINE_SAMPLES=10
CHAT_FEEDBACK_SUMMARY_MAX_NEGATIVE_ONLINE_SAMPLES=30
CHAT_FEEDBACK_SUMMARY_MAX_NEGATIVE_OFFLINE_SAMPLES=30

# ── Object storage (MinIO local default, or AWS S3) ───────
# Backend: minio (compose default) or s3 (AWS / S3-compatible).
OBJECT_STORAGE_BACKEND=minio
# Compose maps host port 19902 to MinIO S3 API (container 9000);
# 19000 is ClickHouse native. Console UI is on host port 19001.
# Compose services hardcode minio:9000 (in-network); these host
# values are for running platform outside Compose.
OBJECT_STORAGE_ENDPOINT=localhost:19902
OBJECT_STORAGE_PRESIGNED_ENDPOINT=localhost:19902
# proxy = sign against PRESIGNED_ENDPOINT (compose/nginx); direct = AWS/MinIO data host.
OBJECT_STORAGE_PRESIGN_MODE=proxy
OBJECT_STORAGE_ACCESS_KEY=microcoaching
OBJECT_STORAGE_SECRET_KEY=microcoaching123
OBJECT_STORAGE_BUCKET_NAME=medtronics-storage
# Honored only for backend=minio; forced false for backend=s3.
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
# Local Docker uses plain HTTP; set true for TLS endpoints / AWS.
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_REGION=us-east-1
#
# --- Optional: point local platform at a real AWS S3 bucket ---
# OBJECT_STORAGE_BACKEND=s3
# OBJECT_STORAGE_ENDPOINT=          # leave empty for regional AWS endpoint
# OBJECT_STORAGE_PRESIGNED_ENDPOINT=
# OBJECT_STORAGE_PRESIGN_MODE=direct
# OBJECT_STORAGE_ACCESS_KEY=        # or leave empty to use AWS default credential chain
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_BUCKET_NAME=your-bucket
# OBJECT_STORAGE_AUTO_CREATE_BUCKET=false
# OBJECT_STORAGE_SECURE=true
# OBJECT_STORAGE_REGION=us-east-1
# Ops prerequisites for S3: pre-create the bucket; IAM needs
# s3:GetObject, s3:PutObject, s3:HeadObject, s3:ListBucket (as used);
# configure bucket CORS if browsers fetch direct presigned URLs.
ADMIN_FILE_ALLOWED_PREFIXES=uploads,source-documents,media,ingest,module-thumbnails
ADMIN_FILE_UPLOAD_PREFIX=uploads
ADMIN_FILE_PRESIGNED_MAX_SECONDS=86400

# ── Coaching RAG ───────────────────────────────────────────
COACHING_RAG_MODULE_LIMIT=5
COACHING_RAG_PRESIGNED_URL_TTL_SECONDS=3600
COACHING_RAG_CONTEXT_MAX_CHARS=28000

# ── ClickHouse (platform only) ───────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=18123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Analytics dashboard (docker compose --profile dashboard) ─────────────
# Optional UI from micro-learning-analytics-dashboard. Build the image locally
# (see docker-compose.yml) or set ANALYTICS_DASHBOARD_BUILD_CONTEXT to that repo.
# ANALYTICS_DASHBOARD_IMAGE=micro-learning-analytics-dashboard:local
# ANALYTICS_DASHBOARD_PORT=18080
# ANALYTICS_DASHBOARD_BUILD_CONTEXT=../micro-learning-analytics-dashboard
# VITE_ADMIN_API_BASE_URL=http://localhost:18000
# VITE_USE_MOCK_API=false

# ── Safety ───────────────────────────────────────────────
RETRIEVAL_REQUIRE_VALIDATED=false
SPICE_REFERRAL_DESTINATIONS=Upazila Health Complex (UHC),Community Clinic,District Hospital,Union Health Centre,Mother and Child Welfare Centre (MCWC),Emergency Obstetric Care (EmOC),Nutrition Rehabilitation Unit (NRU),Upazila Health and Family Planning Officer (UHFPO),BRAC Health Programme Clinic
